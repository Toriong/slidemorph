{
  "name": "slidemorph",
  "version": "1.0.0",
  "description": "Insert HEIC, PDF pages, SVG, WebP and AVIF images into Google Slides",
  "main": "dist/Code.js",
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "push": "npm run build && clasp push",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "google-slides",
    "apps-script",
    "image-conversion"
  ],
  "author": "Toriong",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "@types/jest": "^29.5.11",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "canvas": "^3.2.3",
    "eslint": "^8.56.0",
    "gas-webpack-plugin": "^2.6.0",
    "jest": "^29.7.0",
    "playwright": "^1.64.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
