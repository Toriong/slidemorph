{
  "name": "slidemorph",
  "version": "1.0.0",
  "description": "Convert HEIC, PDF pages, SVG, WebP, and AVIF images to PNG and insert them into Google Slides",
  "main": "dist/Code.js",
  "scripts": {
    "build": "npm run clean && npm run webpack && npm run copy-html && npm run copy-manifest",
    "clean": "rm -rf dist",
    "webpack": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "copy-html": "cp src/*.html dist/",
    "copy-manifest": "cp appsscript.json dist/",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "npm run lint && npm run type-check && npm run build",
    "push": "npm run build && clasp push",
    "deploy": "npm run push && clasp deploy"
  },
  "keywords": [
    "google-slides",
    "google-docs",
    "apps-script",
    "heic",
    "pdf",
    "svg",
    "webp",
    "avif",
    "image-conversion"
  ],
  "author": "Toriong",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {}
}
